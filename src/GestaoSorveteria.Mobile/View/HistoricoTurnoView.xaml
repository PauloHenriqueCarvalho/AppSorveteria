<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SorveteriaMaui.ViewModel"
             xmlns:model="clr-namespace:SorveteriaMaui.Model"
             x:Class="SorveteriaMaui.View.HistoricoTurnoView"
             x:DataType="vm:HistoricoTurnoViewModel"
             Title="Turno"
             BackgroundColor="{StaticResource CorFundo}">

    <!-- C5: vendas pagas e canceladas do caixa, com a situação do envio (RN-SY-03/05) -->
    <Grid RowDefinitions="Auto, Auto, *" Padding="16" RowSpacing="12">

        <Border Grid.Row="0" Style="{StaticResource CartaoDestaque}">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Titulo}" TextColor="White" Opacity="0.9" FontSize="14" />
                <Label Text="{Binding Resumo}" TextColor="White" FontSize="22" FontFamily="OpenSansSemibold" />
            </VerticalStackLayout>
        </Border>

        <!-- Toque envia agora (ou pede o PIN se a sessão venceu) -->
        <Border Grid.Row="1" Style="{StaticResource FaixaInfo}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding EnviarAgoraCommand}" />
            </Border.GestureRecognizers>
            <Label Text="{Binding IndicadorEnvio}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource CorInfo}" />
        </Border>

        <RefreshView Grid.Row="2" Command="{Binding EnviarAgoraCommand}" IsRefreshing="{Binding Atualizando}" RefreshColor="{StaticResource CorMarca}">
            <CollectionView ItemsSource="{Binding Comandas}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Nenhuma venda paga ou cancelada neste caixa ainda." FontSize="15" TextColor="{StaticResource CorTextoSuave}"
                           HorizontalTextAlignment="Center" Margin="0,40,0,0" IsVisible="{Binding Vazio}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Comanda">
                        <Border Style="{StaticResource Cartao}" Margin="0,0,0,10" Padding="14">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding EhRejeitada}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource CorAtencao}" />
                                    <Setter Property="BackgroundColor" Value="{StaticResource CorAtencaoFundo}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}"
                                                      Command="{Binding VerComandaCommand, Source={RelativeSource AncestorType={x:Type vm:HistoricoTurnoViewModel}}}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0" FontSize="16" FontFamily="OpenSansSemibold" TextColor="{StaticResource CorTexto}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Numero, StringFormat='Nº {0}'}" />
                                            <Span Text="{Binding EncerradaEmLocal, StringFormat='  ·  {0:HH:mm}'}" />
                                            <Span Text="{Binding StatusTexto, StringFormat='  ·  {0}'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding EhCancelada}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource CorTextoApagado}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Total, StringFormat='R$ {0:N2}'}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="{StaticResource CorTexto}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding EhCancelada}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource CorTextoApagado}" />
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SituacaoEnvio}" FontSize="13" TextColor="{StaticResource CorTextoSuave}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
