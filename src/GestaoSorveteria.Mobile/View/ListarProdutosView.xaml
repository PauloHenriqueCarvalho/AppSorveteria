<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SorveteriaMaui.ViewModel"
             xmlns:model="clr-namespace:SorveteriaMaui.Model"
             x:Class="SorveteriaMaui.View.ListarProdutosView"
             x:DataType="vm:ListarProdutosViewModel"
             Title="Produtos"
             BackgroundColor="{StaticResource CorFundo}">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- C2: catálogo vem da API; o cadastro é no painel. Aqui só consulta e "Atualizar". -->
        <Border Grid.Row="0" Style="{StaticResource Cartao}" Margin="16,16,16,8">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label Text="Cardápio do tablet" Style="{StaticResource TituloSecao}" />
                    <Label Text="{Binding UltimaAtualizacao}" Style="{StaticResource TextoSuave}" FontSize="13" />
                    <Label Text="{Binding Mensagem}" IsVisible="{Binding TemMensagem}" FontSize="13" TextColor="{StaticResource CorInfo}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="🔄  Atualizar"
                        Style="{StaticResource BotaoSecundario}"
                        IsEnabled="{Binding Livre}"
                        Command="{Binding AtualizarCommand}" />
            </Grid>
        </Border>

        <Label Grid.Row="1"
               IsVisible="{Binding SemProdutos}"
               Margin="24"
               Style="{StaticResource TextoSuave}"
               FontSize="16"
               HorizontalTextAlignment="Center"
               Text="Nenhum produto neste aparelho. Cadastre os produtos no painel e toque em Atualizar (precisa de internet)." />

        <RefreshView Grid.Row="2" IsRefreshing="{Binding Ocupado}" Command="{Binding AtualizarCommand}" RefreshColor="{StaticResource CorMarca}">
            <CollectionView ItemsSource="{Binding Produtos}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Produto">
                        <Border Style="{StaticResource Cartao}" Margin="16,0,16,10" Padding="14">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Nome}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="{StaticResource CorTexto}" />
                                    <Label Text="{Binding Categoria}" Style="{StaticResource TextoSuave}" FontSize="13" />
                                    <HorizontalStackLayout Spacing="6">
                                        <!-- RN-PR-02 -->
                                        <Border Style="{StaticResource Selo}" BackgroundColor="{StaticResource CorLaranjaClara}" IsVisible="{Binding PermiteValorLivre}">
                                            <Label Text="valor digitado na venda" Style="{StaticResource TextoSelo}" TextColor="{StaticResource CorAtencao}" />
                                        </Border>
                                        <!-- RN-ES-09: pote ligado a grupo com saldo pela venda -->
                                        <Border Style="{StaticResource Selo}" BackgroundColor="{StaticResource CorMarcaClara}" IsVisible="{Binding PedeSaborNaVenda}">
                                            <Label Text="escolhe o sabor" Style="{StaticResource TextoSelo}" TextColor="{StaticResource CorMarca}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding Preco, StringFormat='R$ {0:F2}'}" Style="{StaticResource Dinheiro}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
