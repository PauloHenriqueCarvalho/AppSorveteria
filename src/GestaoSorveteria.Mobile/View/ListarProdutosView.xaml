<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SorveteriaMaui.ViewModel"
             xmlns:model="clr-namespace:SorveteriaMaui.Model"
             x:Class="SorveteriaMaui.View.ListarProdutosView"
             x:DataType="vm:ListarProdutosViewModel"
             Title="Produtos"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- C2: catálogo vem da API; o cadastro é no painel. Aqui só consulta e "Atualizar". -->
        <Grid Grid.Row="0" Padding="10" ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                <Label Text="{Binding UltimaAtualizacao}" FontSize="13" TextColor="#555" />
                <Label Text="{Binding Mensagem}" IsVisible="{Binding TemMensagem}" FontSize="13" TextColor="#1976D2" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="🔄  Atualizar"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    HeightRequest="56"
                    CornerRadius="10"
                    Command="{Binding AtualizarCommand}" />
        </Grid>

        <Label Grid.Row="1"
               IsVisible="{Binding SemProdutos}"
               Margin="20"
               FontSize="16"
               TextColor="#555"
               HorizontalTextAlignment="Center"
               Text="Nenhum produto neste aparelho. Cadastre os produtos no painel e toque em Atualizar (precisa de internet)." />

        <RefreshView Grid.Row="2" IsRefreshing="{Binding Ocupado}" Command="{Binding AtualizarCommand}">
            <CollectionView ItemsSource="{Binding Produtos}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Produto">
                        <Frame Margin="10,6" Padding="12" CornerRadius="10" HasShadow="True">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="16"/>
                                    <Label Text="{Binding Categoria}" FontSize="12" TextColor="Gray"/>
                                    <!-- RN-PR-02 -->
                                    <Label Text="valor digitado na venda" IsVisible="{Binding PermiteValorLivre}" FontSize="11" TextColor="#FF9800"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding Preco, StringFormat='R$ {0:F2}'}" VerticalOptions="Center" FontAttributes="Bold"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
