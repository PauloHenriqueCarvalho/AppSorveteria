<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SorveteriaMaui.View.SelecaoProdutoView"
             Title="Adicionar Produto"
             BackgroundColor="#F4F4F9">
    <Grid RowDefinitions="Auto, *, Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="15" Padding="15,15,15,5">

            <Button Text="⚖️ Lançar Self-Service (Peso)"
                    Command="{Binding PrecoManualCommand}"
                    BackgroundColor="#FF9800"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="60"
                    FontSize="18"
                    Shadow="{Shadow Brush=Black, Offset='0,3', Opacity=0.2}"/>

            <SearchBar Placeholder="Buscar sorvete, picolé, bebida..."
                       Text="{Binding FiltroNome}"
                       SearchCommand="{Binding BuscarCommand}"
                       BackgroundColor="White"
                       CancelButtonColor="Gray"/>

            <!-- B12: filtro por categoria -->
            <CollectionView ItemsSource="{Binding Categorias}"
                            SelectionMode="Single"
                            SelectedItem="{Binding CategoriaSelecionada}"
                            HeightRequest="44">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 18" Stroke="#6200EE" StrokeThickness="1" Padding="16,8" BackgroundColor="White">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="White" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#E8DEF8" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Label Text="{Binding .}" TextColor="#6200EE" FontAttributes="Bold" VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Produtos}" Margin="15,10,15,10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="#E0E0E0"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Margin="0,0,0,10"
                            Padding="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="16" TextColor="#333"/>
                                <Label Text="{Binding Preco, StringFormat='R$ {0:F2}'}" TextColor="#4CAF50" FontSize="14" FontAttributes="Bold"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="+ Add"
                                    BackgroundColor="#6200EE"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="40"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelecionarProdutoCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="2"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="20"
                Shadow="{Shadow Brush=Black, Offset='0,-4', Opacity=0.1}">

            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="Quantidade a lançar:" FontSize="14" TextColor="Gray" />
                    <Label Text="Selecione abaixo e depois adicione o item." FontSize="11" TextColor="#888"/>
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="15" VerticalOptions="Center">
                    <Button Text="-" Command="{Binding DiminuirQtdeCommand}" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="#F0F0F0" TextColor="#333" FontSize="24" FontAttributes="Bold"/>
                    <Label Text="{Binding Quantidade}" VerticalOptions="Center" FontSize="26" FontAttributes="Bold" WidthRequest="30" HorizontalTextAlignment="Center" TextColor="#333"/>
                    <Button Text="+" Command="{Binding AumentarQtdeCommand}" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="#E3F2FD" TextColor="#1976D2" FontSize="24" FontAttributes="Bold"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>