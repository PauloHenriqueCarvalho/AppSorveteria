<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SorveteriaMaui.ViewModel"
             x:Class="SorveteriaMaui.View.SelecaoProdutoView"
             Title="Adicionar produto"
             BackgroundColor="{StaticResource CorFundo}">
    <Grid RowDefinitions="Auto, *, Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="12" Padding="16,16,16,4">

            <Button Text="⚖️  Self-service (valor da balança)"
                    Command="{Binding PrecoManualCommand}"
                    Style="{StaticResource BotaoBase}"
                    BackgroundColor="{StaticResource CorLaranjaClara}"
                    TextColor="{StaticResource CorAtencao}"
                    HeightRequest="60"
                    FontSize="18" />

            <SearchBar Placeholder="Buscar sorvete, picolé, bebida..."
                       Text="{Binding FiltroNome}"
                       SearchCommand="{Binding BuscarCommand}"
                       BackgroundColor="White"
                       CancelButtonColor="{StaticResource CorTextoSuave}"/>

            <!-- B12: filtro por categoria -->
            <CollectionView ItemsSource="{Binding Categorias}"
                            SelectionMode="Single"
                            SelectedItem="{Binding CategoriaSelecionada}"
                            HeightRequest="44">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 20" Stroke="{StaticResource CorBordaForte}" StrokeThickness="1" Padding="16,8" BackgroundColor="White">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="White" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource CorMarcaClara}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Label Text="{Binding .}" TextColor="{StaticResource CorMarca}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- C2: sem catálogo baixado, orienta em vez de mostrar lista vazia -->
        <Label Grid.Row="1"
               IsVisible="{Binding SemProdutos}"
               Margin="20"
               FontSize="16"
               TextColor="{StaticResource CorTextoSuave}"
               HorizontalTextAlignment="Center"
               VerticalOptions="Start"
               Text="Nenhum produto neste aparelho. Na aba Produtos, toque em Atualizar (precisa de internet). O self-service continua disponível." />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Produtos}" Margin="16,8,16,8">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Cartao}"
                            Margin="0,0,0,10"
                            Padding="14">
                        <!-- Toque em qualquer lugar do cartão lança o produto, como o botão -->
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="{Binding .}"
                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelecionarProdutoCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding Nome}" FontFamily="OpenSansSemibold" FontSize="17" TextColor="{StaticResource CorTexto}"/>
                                <Label Text="{Binding Preco, StringFormat='R$ {0:F2}'}" TextColor="{StaticResource CorMarca}" FontSize="15" FontFamily="OpenSansSemibold"/>
                                <!-- RN-ES-09: pote abre a grade de sabores -->
                                <Border Style="{StaticResource Selo}" BackgroundColor="{StaticResource CorMarcaClara}" IsVisible="{Binding PedeSaborNaVenda}">
                                    <Label Text="escolhe o sabor" Style="{StaticResource TextoSelo}" TextColor="{StaticResource CorMarca}" />
                                </Border>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="+ Lançar"
                                    Style="{StaticResource BotaoPrimario}"
                                    FontSize="15"
                                    HeightRequest="48"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelecionarProdutoCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- RN-ES-09: grade de sabores, só nos potes. Cobre a busca e a lista; a quantidade (embaixo) continua valendo.
             1 toque no sabor (ou em "Sem sabor") lança o pote; "Voltar" não lança nada. -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              IsVisible="{Binding EscolhendoSabor}"
              BackgroundColor="{StaticResource CorFundo}"
              RowDefinitions="Auto, *"
              Padding="15,15,15,5">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" Margin="0,0,0,10">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding TituloSabor}" Style="{StaticResource TituloSecao}" FontSize="22" />
                    <Label Text="Qual sabor? Com fila, toque em Sem sabor." FontSize="15" TextColor="{StaticResource CorTextoSuave}" />
                </VerticalStackLayout>
                <!-- RN-ES-09: pular o sabor — entra sem baixa de estoque e a contagem semanal corrige -->
                <Button Grid.Column="1"
                        Text="Sem sabor"
                        Style="{StaticResource BotaoPrimario}"
                        VerticalOptions="Center"
                        Command="{Binding SemSaborCommand}" />
                <Button Grid.Column="2"
                        Text="Voltar"
                        Style="{StaticResource BotaoSuave}"
                        VerticalOptions="Center"
                        Command="{Binding CancelarSaborCommand}" />
            </Grid>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Sabores}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="10" HorizontalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SaborParaEscolher">
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource CorMarca}"
                                StrokeThickness="2"
                                BackgroundColor="White"
                                Padding="10"
                                HeightRequest="84">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}"
                                                      Command="{Binding EscolherSaborCommand, Source={RelativeSource AncestorType={x:Type vm:SelecaoProdutoViewModel}}}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Nome}"
                                   FontSize="18"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource CorMarca}"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap"
                                   MaxLines="2" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Border Grid.Row="2"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="16,14"
                Shadow="{Shadow Brush=Black, Offset='0,-3', Opacity=0.08, Radius=12}">

            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="QUANTIDADE A LANÇAR" Style="{StaticResource Legenda}" />
                    <Label Text="Toque no número para digitar (ex.: 50)." Style="{StaticResource TextoSuave}" FontSize="12"/>
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="15" VerticalOptions="Center">
                    <Button Text="−" Command="{Binding DiminuirQtdeCommand}" Style="{StaticResource BotaoRedondo}" WidthRequest="52" HeightRequest="52" CornerRadius="26"/>
                    <!-- RN-ES-04: tocar no número abre o teclado numérico -->
                    <Button Text="{Binding Quantidade}" Command="{Binding DigitarQtdeCommand}" Style="{StaticResource BotaoNumero}" VerticalOptions="Center" FontSize="24" WidthRequest="76" HeightRequest="52" SemanticProperties.Description="Digitar a quantidade"/>
                    <Button Text="+" Command="{Binding AumentarQtdeCommand}" Style="{StaticResource BotaoRedondo}" WidthRequest="52" HeightRequest="52" CornerRadius="26" BackgroundColor="{StaticResource CorMarcaClara}" TextColor="{StaticResource CorMarca}"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>