<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SorveteriaMaui.ViewModel"
             x:Class="SorveteriaMaui.View.SelecaoProdutoView"
             Title="Adicionar Produto"
             BackgroundColor="#F4F4F9">
    <Grid RowDefinitions="Auto, *, Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="15" Padding="15,15,15,5">

            <Button Text="⚖️ Lançar Self-Service (Peso)"
                    Command="{Binding PrecoManualCommand}"
                    BackgroundColor="#FF9800"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="60"
                    FontSize="18"
                    Shadow="{Shadow Brush=Black, Offset='0,3', Opacity=0.2}"/>

            <SearchBar Placeholder="Buscar sorvete, picolé, bebida..."
                       Text="{Binding FiltroNome}"
                       SearchCommand="{Binding BuscarCommand}"
                       BackgroundColor="White"
                       CancelButtonColor="Gray"/>

            <!-- B12: filtro por categoria -->
            <CollectionView ItemsSource="{Binding Categorias}"
                            SelectionMode="Single"
                            SelectedItem="{Binding CategoriaSelecionada}"
                            HeightRequest="44">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 18" Stroke="#6200EE" StrokeThickness="1" Padding="16,8" BackgroundColor="White">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="White" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#E8DEF8" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Label Text="{Binding .}" TextColor="#6200EE" FontAttributes="Bold" VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- C2: sem catálogo baixado, orienta em vez de mostrar lista vazia -->
        <Label Grid.Row="1"
               IsVisible="{Binding SemProdutos}"
               Margin="20"
               FontSize="16"
               TextColor="#555"
               HorizontalTextAlignment="Center"
               VerticalOptions="Start"
               Text="Nenhum produto neste aparelho. Na aba Produtos, toque em Atualizar (precisa de internet). O self-service continua disponível." />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Produtos}" Margin="15,10,15,10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="#E0E0E0"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Margin="0,0,0,10"
                            Padding="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="16" TextColor="#333"/>
                                <Label Text="{Binding Preco, StringFormat='R$ {0:F2}'}" TextColor="#4CAF50" FontSize="14" FontAttributes="Bold"/>
                                <!-- RN-ES-09: pote abre a grade de sabores -->
                                <Label Text="escolhe o sabor" IsVisible="{Binding PedeSaborNaVenda}" FontSize="12" TextColor="#6200EE"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="+ Add"
                                    BackgroundColor="#6200EE"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="40"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelecionarProdutoCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- RN-ES-09: grade de sabores, só nos potes. Cobre a busca e a lista; a quantidade (embaixo) continua valendo.
             1 toque no sabor (ou em "Sem sabor") lança o pote; "Voltar" não lança nada. -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              IsVisible="{Binding EscolhendoSabor}"
              BackgroundColor="#F4F4F9"
              RowDefinitions="Auto, *"
              Padding="15,15,15,5">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" Margin="0,0,0,10">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding TituloSabor}" FontSize="22" FontAttributes="Bold" TextColor="#212121" />
                    <Label Text="Qual sabor? Com fila, toque em Sem sabor." FontSize="15" TextColor="#616161" />
                </VerticalStackLayout>
                <!-- RN-ES-09: pular o sabor — entra sem baixa de estoque e a contagem semanal corrige -->
                <Button Grid.Column="1"
                        Text="Sem sabor"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="56"
                        Padding="20,0"
                        CornerRadius="10"
                        BackgroundColor="#6200EE"
                        TextColor="White"
                        VerticalOptions="Center"
                        Command="{Binding SemSaborCommand}" />
                <Button Grid.Column="2"
                        Text="Voltar"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="56"
                        Padding="20,0"
                        CornerRadius="10"
                        BackgroundColor="#F0F0F0"
                        TextColor="#333"
                        VerticalOptions="Center"
                        Command="{Binding CancelarSaborCommand}" />
            </Grid>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Sabores}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="10" HorizontalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SaborParaEscolher">
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="#6200EE"
                                StrokeThickness="2"
                                BackgroundColor="White"
                                Padding="10"
                                HeightRequest="84">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}"
                                                      Command="{Binding EscolherSaborCommand, Source={RelativeSource AncestorType={x:Type vm:SelecaoProdutoViewModel}}}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Nome}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#4527A0"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap"
                                   MaxLines="2" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Border Grid.Row="2"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="20"
                Shadow="{Shadow Brush=Black, Offset='0,-4', Opacity=0.1}">

            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="Quantidade a lançar:" FontSize="14" TextColor="Gray" />
                    <Label Text="Toque no número para digitar (ex.: 50)." FontSize="11" TextColor="#888"/>
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="15" VerticalOptions="Center">
                    <Button Text="-" Command="{Binding DiminuirQtdeCommand}" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="#F0F0F0" TextColor="#333" FontSize="24" FontAttributes="Bold"/>
                    <!-- RN-ES-04: tocar no número abre o teclado numérico -->
                    <Button Text="{Binding Quantidade}" Command="{Binding DigitarQtdeCommand}" VerticalOptions="Center" FontSize="24" FontAttributes="Bold" WidthRequest="72" HeightRequest="50" CornerRadius="12" BackgroundColor="White" BorderColor="#BDBDBD" BorderWidth="1" TextColor="#333" SemanticProperties.Description="Digitar a quantidade"/>
                    <Button Text="+" Command="{Binding AumentarQtdeCommand}" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="#E3F2FD" TextColor="#1976D2" FontSize="24" FontAttributes="Bold"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>