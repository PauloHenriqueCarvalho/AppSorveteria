<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SorveteriaMaui.ViewModel"
             xmlns:model="clr-namespace:SorveteriaMaui.Model"
             x:Class="SorveteriaMaui.View.CaixaView"
             x:DataType="vm:CaixaViewModel"
             Title="Caixa"
             BackgroundColor="{StaticResource CorFundo}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Caixa recusado pelo servidor: nunca some em silêncio (RN-SY-03); caixa preso sai pelo painel (RN-CX-09) -->
            <Border IsVisible="{Binding TemAvisoServidor}" Style="{StaticResource FaixaAtencao}">
                <Label Text="{Binding AvisoServidor}" FontSize="14" TextColor="{StaticResource CorAtencao}" />
            </Border>

            <!-- Sem caixa: abrir com fundo de troco (RN-CX-02; exige internet, RN-SY-04) -->
            <Border IsVisible="{Binding SemCaixaAberto}" Style="{StaticResource Cartao}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="🔒" FontSize="36" HorizontalOptions="Center" />
                    <Label Text="Caixa fechado" Style="{StaticResource TituloTela}" HorizontalOptions="Center" />
                    <Label Text="Para começar a vender, abra o caixa com o dinheiro de troco que já está na gaveta (pode ser 0). Precisa de internet só para abrir."
                           Style="{StaticResource TextoSuave}" HorizontalTextAlignment="Center" />
                    <Label Text="FUNDO DE TROCO (R$)" Style="{StaticResource Legenda}" Margin="0,8,0,0" />
                    <Entry Text="{Binding FundoTrocoTexto}" Placeholder="0,00" Keyboard="Telephone" Style="{StaticResource CampoGrande}" FontSize="28" HorizontalTextAlignment="Center" />
                    <Button Text="Abrir caixa" Style="{StaticResource BotaoSucesso}" HeightRequest="64" FontSize="20"
                            Command="{Binding AbrirCaixaCommand}" />
                    <Label Text="{Binding UltimoFechamento}" IsVisible="{Binding TemUltimoFechamento}" Style="{StaticResource TextoSuave}" FontSize="13" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Caixa aberto: números do turno (RN-CX-06, calculados pelo Domain) -->
            <Border IsVisible="{Binding TemCaixaAberto}" Style="{StaticResource CartaoDestaque}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="DEVE TER NA GAVETA AGORA" TextColor="White" Opacity="0.9" FontSize="12" FontFamily="OpenSansSemibold" CharacterSpacing="0.6" />
                    <Label Text="{Binding Resumo.Esperado, StringFormat='R$ {0:F2}'}" TextColor="White" FontSize="40" FontFamily="OpenSansSemibold" />
                    <Label Text="fundo + vendas em dinheiro + reforços − retiradas" TextColor="White" Opacity="0.85" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding TemCaixaAberto}" Style="{StaticResource Cartao}">
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                    <Label Grid.Row="0" Text="Fundo de troco" Style="{StaticResource Texto}" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Resumo.FundoTroco, StringFormat='R$ {0:F2}'}" Style="{StaticResource Dinheiro}" FontSize="16" />
                    <Label Grid.Row="1" Text="+ Vendas em dinheiro" Style="{StaticResource Texto}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Resumo.VendasDinheiro, StringFormat='R$ {0:F2}'}" Style="{StaticResource Dinheiro}" FontSize="16" TextColor="{StaticResource CorBom}" />
                    <Label Grid.Row="2" Text="+ Reforços (suprimentos)" Style="{StaticResource Texto}" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Resumo.Suprimentos, StringFormat='R$ {0:F2}'}" Style="{StaticResource Dinheiro}" FontSize="16" TextColor="{StaticResource CorInfo}" />
                    <Label Grid.Row="3" Text="− Retiradas (sangrias)" Style="{StaticResource Texto}" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Resumo.Sangrias, StringFormat='R$ {0:F2}'}" Style="{StaticResource Dinheiro}" FontSize="16" TextColor="{StaticResource CorRuim}" />
                    <BoxView Grid.Row="4" Grid.ColumnSpan="2" HeightRequest="1" Color="{StaticResource CorBorda}" />
                    <Label Grid.Row="5" Text="Total vendido (todas as formas)" Style="{StaticResource TextoSuave}" />
                    <Label Grid.Row="5" Grid.Column="1" Text="{Binding Resumo.TotalVendido, StringFormat='R$ {0:F2}'}" Style="{StaticResource TextoSuave}" FontFamily="OpenSansSemibold" />
                    <Label Grid.Row="6" Text="Comandas pagas / abertas" Style="{StaticResource TextoSuave}" />
                    <HorizontalStackLayout Grid.Row="6" Grid.Column="1" Spacing="4">
                        <Label Text="{Binding Resumo.ComandasFechadas}" Style="{StaticResource TextoSuave}" FontFamily="OpenSansSemibold" />
                        <Label Text="/" Style="{StaticResource TextoSuave}" />
                        <Label Text="{Binding Resumo.ComandasAbertas}" Style="{StaticResource TextoSuave}" FontFamily="OpenSansSemibold" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- RN-CX-04 -->
            <Grid IsVisible="{Binding TemCaixaAberto}" ColumnDefinitions="*, *" ColumnSpacing="12">
                <Button Grid.Column="0" Text="− Retirada" Style="{StaticResource BotaoBase}" BackgroundColor="{StaticResource CorRuimFundo}" TextColor="{StaticResource CorRuim}"
                        Command="{Binding SangriaCommand}" />
                <Button Grid.Column="1" Text="+ Reforço" Style="{StaticResource BotaoBase}" BackgroundColor="{StaticResource CorInfoFundo}" TextColor="{StaticResource CorInfo}"
                        Command="{Binding SuprimentoCommand}" />
            </Grid>

            <Label IsVisible="{Binding TemCaixaAberto}" Text="RETIRADAS E REFORÇOS DO TURNO" Style="{StaticResource Legenda}" Margin="4,8,0,0" />
            <CollectionView IsVisible="{Binding TemCaixaAberto}" ItemsSource="{Binding Movimentos}" SelectionMode="None" HeightRequest="200">
                <CollectionView.EmptyView>
                    <Label Text="Nenhuma sangria ou suprimento ainda." FontSize="13" TextColor="{StaticResource CorTextoSuave}" Margin="8" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:MovimentoCaixa">
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="8,6" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{Binding EmLocal, StringFormat='{0:HH:mm}'}" TextColor="{StaticResource CorTextoSuave}" FontSize="13" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding TipoTexto}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource CorTexto}" />
                                <Label Text="{Binding Motivo}" FontSize="12" TextColor="{StaticResource CorTextoSuave}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding Valor, StringFormat='R$ {0:F2}'}" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- RN-CX-05/06 -->
            <Button IsVisible="{Binding TemCaixaAberto}" Text="Fechar caixa (contar a gaveta)" Style="{StaticResource BotaoPerigo}" HeightRequest="64"
                    Margin="0,8,0,8"
                    Command="{Binding FecharCaixaCommand}" />

            <!-- RN-ES-05: contagem semanal do freezer; no dia dela (véspera do pedido) o cartão fica em destaque -->
            <Border Style="{StaticResource Cartao}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding LembreteContagem}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource CorMarca}" />
                        <Setter Property="StrokeThickness" Value="2" />
                        <Setter Property="BackgroundColor" Value="{StaticResource CorMarcaClara}" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Contagem semanal do freezer" Style="{StaticResource TituloSecao}" />
                    <Label Text="{Binding TextoContagem}" FontSize="14" TextColor="{StaticResource CorTextoSuave}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding LembreteContagem}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource CorMarca}" />
                                <Setter Property="FontAttributes" Value="Bold" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Text="📋  Abrir a contagem" Style="{StaticResource BotaoSecundario}"
                            Command="{Binding ContagemCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- RN-AV-07: resumo do dia para o WhatsApp da dona — oferecido ao fechar o caixa; aqui a qualquer hora -->
            <Border Style="{StaticResource Cartao}" Margin="0,0,0,16">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding ResumoPendente}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource CorAtencao}" />
                        <Setter Property="BackgroundColor" Value="{StaticResource CorAtencaoFundo}" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Resumo do dia para a dona" Style="{StaticResource TituloSecao}" />
                    <Label Text="⚠ O resumo de hoje ainda não foi enviado." IsVisible="{Binding ResumoPendente}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource CorAtencao}" />
                    <Label Text="O que está acabando e o total vendido hoje, pronto para mandar no WhatsApp." FontSize="13" TextColor="{StaticResource CorTextoSuave}" />
                    <Label Text="{Binding MensagemResumo}" IsVisible="{Binding TemMensagemResumo}" FontSize="13" TextColor="{StaticResource CorAtencao}" />
                    <Button Text="📲  Enviar resumo do dia" Style="{StaticResource BotaoBase}"
                            BackgroundColor="{StaticResource CorWhatsApp}" TextColor="White"
                            IsEnabled="{Binding PodeEnviarResumo}"
                            Command="{Binding EnviarResumoCommand}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
