<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SorveteriaMaui.ViewModel"
             x:Class="SorveteriaMaui.View.LoginView"
             x:DataType="vm:LoginViewModel"
             Title="Entrar"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource CorFundo}">

    <ContentPage.Resources>
        <!-- Teclado grande: dedo do atendente, tablet no balcão -->
        <Style x:Key="Tecla" TargetType="Button">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="HeightRequest" Value="72" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="{StaticResource CorTexto}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderColor" Value="{StaticResource CorBorda}" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="16" MaximumWidthRequest="440" HorizontalOptions="Center">

            <!-- Marca da loja: mascote Juninho, o mesmo do painel (public/marca/juninho.png) -->
            <Image Source="logo_verao_tropical.png"
                   HeightRequest="120"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   SemanticProperties.Description="Logo da Sorveteria Verão Tropical" />
            <Label Text="Verão Tropical" FontSize="32" FontFamily="OpenSansSemibold" TextColor="{StaticResource CorMarca}" HorizontalOptions="Center" />
            <Label Text="{Binding Subtitulo}" FontSize="16" TextColor="{StaticResource CorTextoSuave}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />

            <Border Style="{StaticResource Cartao}" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="LOGIN" Style="{StaticResource Legenda}" />
                    <Entry Text="{Binding Login}"
                           Placeholder="seu login"
                           Keyboard="Plain"
                           Style="{StaticResource CampoGrande}"
                           FontSize="20"
                           IsEnabled="{Binding Livre}"
                           ReturnType="Next" />

                    <Label Text="PIN (OU SENHA)" Style="{StaticResource Legenda}" Margin="0,6,0,0" />
                    <Entry Text="{Binding Pin}"
                           Placeholder="••••"
                           IsPassword="True"
                           Style="{StaticResource CampoGrande}"
                           FontSize="28"
                           HorizontalTextAlignment="Center"
                           IsEnabled="{Binding Livre}"
                           ReturnType="Go"
                           ReturnCommand="{Binding EntrarCommand}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Button Grid.Row="0" Grid.Column="0" Text="1" Style="{StaticResource Tecla}" Command="{Binding DigitarCommand}" CommandParameter="1" />
                <Button Grid.Row="0" Grid.Column="1" Text="2" Style="{StaticResource Tecla}" Command="{Binding DigitarCommand}" CommandParameter="2" />
                <Button Grid.Row="0" Grid.Column="2" Text="3" Style="{StaticResource Tecla}" Command="{Binding DigitarCommand}" CommandParameter="3" />
                <Button Grid.Row="1" Grid.Column="0" Text="4" Style="{StaticResource Tecla}" Command="{Binding DigitarCommand}" CommandParameter="4" />
                <Button Grid.Row="1" Grid.Column="1" Text="5" Style="{StaticResource Tecla}" Command="{Binding DigitarCommand}" CommandParameter="5" />
                <Button Grid.Row="1" Grid.Column="2" Text="6" Style="{StaticResource Tecla}" Command="{Binding DigitarCommand}" CommandParameter="6" />
                <Button Grid.Row="2" Grid.Column="0" Text="7" Style="{StaticResource Tecla}" Command="{Binding DigitarCommand}" CommandParameter="7" />
                <Button Grid.Row="2" Grid.Column="1" Text="8" Style="{StaticResource Tecla}" Command="{Binding DigitarCommand}" CommandParameter="8" />
                <Button Grid.Row="2" Grid.Column="2" Text="9" Style="{StaticResource Tecla}" Command="{Binding DigitarCommand}" CommandParameter="9" />
                <Button Grid.Row="3" Grid.Column="0" Text="Limpar" FontSize="18" Style="{StaticResource Tecla}" TextColor="{StaticResource CorRuim}" Command="{Binding LimparCommand}" />
                <Button Grid.Row="3" Grid.Column="1" Text="0" Style="{StaticResource Tecla}" Command="{Binding DigitarCommand}" CommandParameter="0" />
                <Button Grid.Row="3" Grid.Column="2" Text="⌫" Style="{StaticResource Tecla}" Command="{Binding ApagarCommand}" />
            </Grid>

            <Button Text="Entrar"
                    Style="{StaticResource BotaoPrimario}"
                    FontSize="22"
                    HeightRequest="68"
                    Command="{Binding EntrarCommand}" />

            <!-- Renovar sessão (token vencido): volta para a tela de onde veio sem trocar o atendente -->
            <Button Text="Voltar sem entrar"
                    IsVisible="{Binding Renovar}"
                    Style="{StaticResource BotaoTexto}"
                    Command="{Binding VoltarCommand}" />

            <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" Color="{StaticResource CorMarca}" />

            <Label Text="{Binding Status}"
                   IsVisible="{Binding TemStatus}"
                   FontSize="16"
                   TextColor="{StaticResource CorTextoSuave}"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding Erro}"
                   IsVisible="{Binding TemErro}"
                   FontSize="16"
                   TextColor="{StaticResource CorRuim}"
                   HorizontalTextAlignment="Center" />

            <!-- Endereço da API, só no build Debug: 10.0.2.2 no emulador; IP do PC no tablet de teste.
                 No Release o campo não existe: a URL vem do build (docs/07). -->
            <VerticalStackLayout IsVisible="{Binding UrlEditavel}" Spacing="8">
                <Button Text="{Binding UrlApi, StringFormat='Servidor: {0}'}"
                        FontSize="12"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource CorTextoSuave}"
                        Command="{Binding AlternarServidorCommand}" />
                <Entry Text="{Binding UrlApi}"
                       IsVisible="{Binding MostrarServidor}"
                       Placeholder="http://192.168.0.10:5080"
                       Keyboard="Url"
                       FontSize="14"
                       IsEnabled="{Binding Livre}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
