<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SorveteriaMaui.ViewModel"
             x:Class="SorveteriaMaui.View.ListarComandasView"
             Title="Verão Tropical">

    <!-- C1: trocar de atendente (volta para o PIN) -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sair" Command="{Binding SairCommand}" />
    </ContentPage.ToolbarItems>

    <!-- Tela inicial do turno: quem está, o caixa, o envio, os atalhos e as comandas abertas. Tudo rola junto. -->
    <CollectionView ItemsSource="{Binding Comandas}" SelectionMode="None" Margin="0">

        <CollectionView.Header>
            <VerticalStackLayout Padding="16,16,16,8" Spacing="12">

                <!-- Quem está no turno e o caixa (C1, C3) -->
                <Border Style="{StaticResource CartaoDestaque}">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding NomeAtendente, StringFormat='Olá, {0}'}" TextColor="White" FontSize="22" FontFamily="OpenSansSemibold" />
                            <Label Text="{Binding EstadoCaixa}" TextColor="White" Opacity="0.9" FontSize="14" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                            <Label Text="{Binding TotalComandasAbertas}" TextColor="White" FontSize="30" FontFamily="OpenSansSemibold" HorizontalOptions="End" />
                            <Label Text="comandas abertas" TextColor="White" Opacity="0.9" FontSize="12" HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- C4 / RN-SY-05: envio sempre visível; toque envia agora (ou pede o PIN) -->
                <Border Style="{StaticResource FaixaInfo}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding EnviarAgoraCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding IndicadorEnvio}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource CorInfo}" />
                        <Label Text="{Binding MensagemEnvio}" FontSize="12" TextColor="{StaticResource CorTextoSuave}" IsVisible="{Binding TemMensagemEnvio}" />
                    </VerticalStackLayout>
                </Border>

                <!-- RN-ES-05: na véspera do pedido, lembrete com atalho (some quando a contagem de hoje é concluída) -->
                <Border Style="{StaticResource FaixaMarca}" IsVisible="{Binding LembreteContagem}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ContagemCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding TextoLembreteContagem}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="{StaticResource CorMarca}" />
                </Border>

                <!-- RN-CM-13: a venda mais comum (pega, paga e vai) em destaque -->
                <Button Text="⚡  Balcão — venda rápida"
                        Style="{StaticResource BotaoPrimario}"
                        HeightRequest="76"
                        FontSize="21"
                        Command="{Binding VendaRapidaCommand}" />

                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="12">
                    <Button Grid.Row="0" Grid.Column="0" Text="➕  Nova comanda" Style="{StaticResource BotaoAtalho}" Command="{Binding NovaComandaCommand}" />
                    <!-- RN-CM-11 -->
                    <Button Grid.Row="0" Grid.Column="1" Text="🛵  Delivery" Style="{StaticResource BotaoAtalho}" Command="{Binding NovoDeliveryCommand}" />
                    <!-- Fase 2 (docs/10 §2.2, RN-AV-01): avisar o que está acabando; urgente vai na hora para o WhatsApp da dona -->
                    <Button Grid.Row="1" Grid.Column="0" Text="{Binding TextoEstaAcabando}" Style="{StaticResource BotaoAtalho}"
                            BackgroundColor="{StaticResource CorAtencaoFundo}" BorderColor="{StaticResource CorAtencaoFundo}" TextColor="{StaticResource CorAtencao}"
                            LineBreakMode="TailTruncation"
                            Command="{Binding EstaAcabandoCommand}" />
                    <!-- Fase 2 (docs/10 §2.1, RN-ES-05): contagem semanal do freezer -->
                    <Button Grid.Row="1" Grid.Column="1" Text="{Binding TextoContagem}" Style="{StaticResource BotaoAtalho}" Command="{Binding ContagemCommand}" />
                </Grid>

                <Label Text="COMANDAS ABERTAS" Style="{StaticResource Legenda}" Margin="4,12,0,0" />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.EmptyView>
            <VerticalStackLayout Padding="32,24" Spacing="6">
                <Label Text="🍦" FontSize="40" HorizontalOptions="Center" />
                <Label Text="Nenhuma comanda aberta" Style="{StaticResource TituloSecao}" HorizontalOptions="Center" />
                <Label Text="Cliente rápido? Use o Balcão. Quem vai sentar ou pedir várias coisas ganha uma comanda."
                       Style="{StaticResource TextoSuave}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource Cartao}" Margin="16,0,16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerDetalhesCommand}"
                            CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                            <!-- Número da comanda (RN-CM-02) -->
                            <Border Grid.Column="0" WidthRequest="48" HeightRequest="48" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 24" BackgroundColor="{StaticResource CorMarcaClara}" VerticalOptions="Start">
                                <Label Text="{Binding Numero}" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource CorMarca}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding NomeCliente, TargetNullValue='Cliente avulso'}" FontSize="18" FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource CorTexto}" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding CriadaEmLocal, StringFormat='Aberta às {0:HH:mm}'}" Style="{StaticResource TextoSuave}" FontSize="13" />
                                <Border Style="{StaticResource Selo}" BackgroundColor="{StaticResource CorInfoFundo}" IsVisible="{Binding EhDelivery}" Margin="0,4,0,0">
                                    <Label Text="🛵 Delivery" Style="{StaticResource TextoSelo}" TextColor="{StaticResource CorInfo}" />
                                </Border>
                                <Label Text="{Binding Observacao}" IsVisible="{Binding TemObservacao}" Style="{StaticResource TextoSuave}" FontSize="13"
                                       LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>

                            <Label Grid.Column="2" Text="{Binding Total, StringFormat='R$ {0:F2}'}" Style="{StaticResource Dinheiro}" FontSize="20"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <Button Grid.Column="0" Text="+ Produto" Style="{StaticResource BotaoSecundario}" HeightRequest="50"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AdicionarProdutoCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Grid.Column="1" Text="Pagar" Style="{StaticResource BotaoSucesso}" HeightRequest="50"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FinalizarComandaCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="16" Color="Transparent" />
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>
