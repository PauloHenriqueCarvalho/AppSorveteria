<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SorveteriaMaui.ViewModel"
             x:Class="SorveteriaMaui.View.ListarComandasView"
             Title="Comandas Abertas"
             BackgroundColor="#F5F5F5">

    <!-- C1: trocar de atendente (volta para o PIN) -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sair" Command="{Binding SairCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, Auto, Auto, *">

        <Frame Grid.Row="0" Margin="10" BackgroundColor="#6200EE" CornerRadius="10" HasShadow="True" BorderColor="Transparent">
            <Grid ColumnDefinitions="*, Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="15" HorizontalOptions="Center">
                    <Label Text="Comandas Ativas:" TextColor="White" VerticalOptions="Center"/>
                    <Label Text="{Binding TotalComandasAbertas}" TextColor="White" FontAttributes="Bold" FontSize="20"/>
                </HorizontalStackLayout>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding NomeAtendente, StringFormat='👤 {0}'}" TextColor="White" FontSize="14" HorizontalTextAlignment="End"/>
                    <!-- C3 -->
                    <Label Text="{Binding EstadoCaixa}" TextColor="White" FontSize="12" HorizontalTextAlignment="End"/>
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- C4 / RN-SY-05: indicador sempre visível; toque envia agora (ou pede o PIN) -->
        <Border Grid.Row="1" Margin="10,0" Padding="12,8" StrokeThickness="0" BackgroundColor="#FFF8E1" StrokeShape="RoundRectangle 8">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding EnviarAgoraCommand}" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding IndicadorEnvio}" FontSize="14" FontAttributes="Bold" TextColor="#5D4037" />
                <Label Text="{Binding MensagemEnvio}" FontSize="12" TextColor="#795548" IsVisible="{Binding TemMensagemEnvio}" />
            </VerticalStackLayout>
        </Border>

        <!-- Topo fixo com Nova Comanda e Venda Rápida; embaixo, "Está acabando" e a contagem semanal (Fase 2) -->
        <Grid Grid.Row="2" ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto, Auto" Padding="10" ColumnSpacing="10" RowSpacing="10">
            <Button Grid.Column="0"
                    Text="➕  Nova Comanda"
                    FontSize="16"
                    HeightRequest="56"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    Command="{Binding NovaComandaCommand}" />

            <!-- RN-CM-11 -->
            <Button Grid.Column="1"
                    Text="🛵  Delivery"
                    FontSize="16"
                    HeightRequest="56"
                    BackgroundColor="#1976D2"
                    TextColor="White"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    Command="{Binding NovoDeliveryCommand}" />

            <!-- RN-CM-13: balcão — toca nos produtos e cobra; o valor digitado fica lá dentro -->
            <Button Grid.Column="2"
                    Text="⚡  Balcão"
                    FontSize="16"
                    HeightRequest="56"
                    BackgroundColor="#FF5722"
                    TextColor="White"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    Command="{Binding VendaRapidaCommand}" />

            <!-- Fase 2 (docs/10 §2.2, RN-AV-01): avisar o que está acabando; urgente vai na hora para o WhatsApp da dona -->
            <Button Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Text="{Binding TextoEstaAcabando}"
                    FontSize="16"
                    HeightRequest="56"
                    BackgroundColor="#FFB300"
                    TextColor="#3E2723"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    Command="{Binding EstaAcabandoCommand}" />

            <!-- Fase 2 (docs/10 §2.1, RN-ES-05): contagem semanal do freezer -->
            <Button Grid.Row="1"
                    Grid.Column="2"
                    Text="{Binding TextoContagem}"
                    FontSize="16"
                    HeightRequest="56"
                    BackgroundColor="#EDE7F6"
                    TextColor="#4527A0"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    Command="{Binding ContagemCommand}" />

            <!-- RN-ES-05: na véspera do pedido, lembrete com atalho (some quando a contagem de hoje é concluída) -->
            <Border Grid.Row="2"
                    Grid.ColumnSpan="3"
                    IsVisible="{Binding LembreteContagem}"
                    Padding="14,12"
                    StrokeThickness="2"
                    Stroke="#4527A0"
                    BackgroundColor="#EDE7F6"
                    StrokeShape="RoundRectangle 10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ContagemCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{Binding TextoLembreteContagem}" FontSize="16" FontAttributes="Bold" TextColor="#4527A0" />
            </Border>
        </Grid>

        <CollectionView Grid.Row="3" 
                        ItemsSource="{Binding Comandas}"
                        Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,0,0,12" Padding="15" CornerRadius="12" HasShadow="True" BorderColor="#E0E0E0">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerDetalhesCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <VerticalStackLayout Spacing="10">

                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Grid Grid.Column="0" WidthRequest="40" HeightRequest="40">
                                    <Ellipse Fill="#03DAC6" />
                                    <Label Text="{Binding Numero}" 
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="White" FontAttributes="Bold"/>
                                </Grid>

                                <VerticalStackLayout Grid.Column="1" Margin="15,0">
                                    <Label Text="{Binding NomeCliente, TargetNullValue='Cliente Avulso'}" 
                                           FontSize="18" FontAttributes="Bold" TextColor="#333"/>
                                    <Label Text="{Binding CriadaEmLocal, StringFormat='{0:HH:mm}'}" 
                                           FontSize="12" TextColor="Gray"/>
                                    <Label Text="🛵 Delivery" IsVisible="{Binding EhDelivery}"
                                           FontSize="12" FontAttributes="Bold" TextColor="#1976D2"/>
                                    <Label Text="{Binding Observacao}" IsVisible="{Binding TemObservacao}"
                                           FontSize="12" TextColor="#555" LineBreakMode="TailTruncation" MaxLines="1"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="2" 
                                       Text="{Binding Total, StringFormat='R$ {0:F2}'}" 
                                       FontSize="18" FontAttributes="Bold" TextColor="#2E7D32" 
                                       VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#EEE" HorizontalOptions="Fill"/>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,5,0,0">
                                <Button Grid.Column="0" 
                                        Text="+ Produto" 
                                        BackgroundColor="#E3F2FD" 
                                        TextColor="#1976D2"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HeightRequest="45"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AdicionarProdutoCommand}"
                                        CommandParameter="{Binding .}"/>

                                <Button Grid.Column="1" 
                                        Text="Finalizar" 
                                        BackgroundColor="#2E7D32" 
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HeightRequest="45"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FinalizarComandaCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Floating button removed; use fixed buttons on topo -->
    </Grid>
</ContentPage>