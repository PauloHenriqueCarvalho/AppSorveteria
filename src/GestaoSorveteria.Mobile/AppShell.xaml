<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SorveteriaMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SorveteriaMaui"
    xmlns:views="clr-namespace:SorveteriaMaui.View"
    Title="SorveteriaMaui"
    FlyoutBehavior="Disabled">

    <!-- Abas do turno (tela inicial quando já há atendente no aparelho) -->
    <TabBar x:Name="Principal">
        <ShellContent Title="Comandas" Route="ListarComandasView" ContentTemplate="{DataTemplate views:ListarComandasView}" />
        <ShellContent Title="Produtos" Route="ListarProdutosView" ContentTemplate="{DataTemplate views:ListarProdutosView}" />
        <ShellContent Title="Caixa" Route="CaixaView" ContentTemplate="{DataTemplate views:CaixaView}" />
        <ShellContent Title="Turno" Route="HistoricoTurnoView" ContentTemplate="{DataTemplate views:HistoricoTurnoView}" />
    </TabBar>

    <!-- Login com PIN (C1): fora das abas, sem barra; o AppShell escolhe qual mostrar ao abrir -->
    <ShellContent x:Name="Login" Title="Entrar" Route="LoginView" ContentTemplate="{DataTemplate views:LoginView}" />

</Shell>
