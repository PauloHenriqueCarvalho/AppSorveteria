<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testes de domínio e aplicação (xUnit v3, modo VSTest: aparece no Test Explorer do Visual Studio
       e roda com `dotnet test`). Sem banco: repositórios são fakes em memória. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GestaoSorveteria.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GestaoSorveteria.Domain\GestaoSorveteria.Domain.csproj" />
    <ProjectReference Include="..\..\src\GestaoSorveteria.Application\GestaoSorveteria.Application.csproj" />
    <ProjectReference Include="..\..\src\GestaoSorveteria.Infrastructure\GestaoSorveteria.Infrastructure.csproj" />
  </ItemGroup>

</Project>
